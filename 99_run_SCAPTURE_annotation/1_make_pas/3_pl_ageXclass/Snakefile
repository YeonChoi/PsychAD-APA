            'peaks/exonic.pas.pass.bed', 
            'peaks/exonic.pas.known.or.pass.bed', 

            'peaks/intronic.pas.pass.bed',
            'peaks/intronic.pas.known.or.pass.bed',

            'peaks/all.pas.pass.bed',
            'peaks/all.pas.known.or.pass.bed',
    threads: 1
    resources: mem_mb=3000
    run:
        shell("""perl -alne '$,="\t";print @F[0..11] if $F[13] eq "positive";' {input.ext3} > {output[0]}""")
        shell("""perl -alne '$,="\t";print @F[0..11] if $F[12] > 0 | $F[13] eq "positive";' {input.ext3} > {output[1]}""")

        shell("""perl -alne '$,="\t";print @F[0..11] if $F[13] eq "positive";' {input.exon} > {output[2]}""")
        shell("""perl -alne '$,="\t";print @F[0..11] if $F[12] > 0 | $F[13] eq "positive";' {input.exon} > {output[3]}""")

        shell("""perl -alne '$,="\t";print @F[0..11] if $F[13] eq "positive";' {input.intron} > {output[4]}""")
        shell("""perl -alne '$,="\t";print @F[0..11] if $F[12] > 0 | $F[13] eq "positive";' {input.intron} > {output[5]}""")

        shell("cat {output[0]} {output[2]} {output[4]} > {output[6]}")
        shell("cat {output[1]} {output[3]} {output[5]} > {output[7]}")
